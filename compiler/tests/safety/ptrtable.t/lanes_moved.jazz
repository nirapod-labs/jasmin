/* A lane pointer moved past its whole blocks, then the tail. */
export fn lanes_moved(reg const ptr u64[1] in, reg u64 len) -> reg u64
{
  reg u64 p off n i b r;

  p = in[0];
  off = len;
  off >>= 6;
  off <<= 6;
  p += off;
  n = len;
  n &= 63;
  r = 0;
  i = 0;
  while (i < n) {
    b = (64u)[:u8 p + i];
    r ^= b;
    i += 1;
  }
  return r;
}
