/* The callee reads past its table of one cell. */
fn second(reg const ptr u64[1] t, reg u64 len) -> reg u64
{
  reg u64 j p i b r;

  j = 1;
  p = t[j];
  r = 0;
  i = 0;
  while (i < len) {
    b = (64u)[:u8 p + i];
    r ^= b;
    i += 1;
  }
  return r;
}

export fn lanes_oob(reg const ptr u64[2] in, reg u64 len) -> reg u64
{
  reg u64 er;

  er = second(in[1 : 1], len);
  return er;
}
