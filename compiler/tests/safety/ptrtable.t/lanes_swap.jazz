/* After the swap, in holds the old contents of c, whose cell 0 is q. */
export fn lanes_swap(reg mut ptr u64[1] in, reg u64 q len) -> reg u64, reg ptr u64[1]
{
  stack u64[1] cs;
  reg ptr u64[1] c;
  reg u64 p i b r;

  c = cs;
  c[0] = q;
  c, in = #swap(c, in);
  p = in[0];
  r = 0;
  i = 0;
  while (i < len) {
    b = (64u)[:u8 p + i];
    r ^= b;
    i += 1;
  }
  return r, in;
}
