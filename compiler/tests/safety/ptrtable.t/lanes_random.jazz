/* The table is overwritten with random bytes. */
export fn lanes_random(reg mut ptr u64[2] in, reg u64 len) -> reg u64, reg ptr u64[2]
{
  reg u64 p i b r;

  in = #randombytes(in);
  p = in[0];
  r = 0;
  i = 0;
  while (i < len) {
    b = (64u)[:u8 p + i];
    r ^= b;
    i += 1;
  }
  return r, in;
}
