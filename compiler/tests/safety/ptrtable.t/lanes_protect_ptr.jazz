/* A table through #protect_ptr keeps its lanes: the read is lane 1. */
export fn lanes_protect_ptr(reg const ptr u64[2] in, reg u64 len) -> reg u64
{
  reg u64 ms p i b r;
  reg ptr u64[2] c;

  ms = #init_msf();
  c = #protect_ptr(in, ms);
  p = c[1];
  r = 0;
  i = 0;
  while (i < len) {
    b = (64u)[:u8 p + i];
    r ^= b;
    i += 1;
  }
  return r;
}
