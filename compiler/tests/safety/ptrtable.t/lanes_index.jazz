/* The cell index is a while counter, not a constant. */
export fn lanes_index(reg const ptr u64[2] in, reg u64 len) -> reg u64
{
  reg u64 p j i b r;

  r = 0;
  j = 0;
  while (j < 2) {
    p = in[j];
    i = 0;
    while (i < len) {
      b = (64u)[:u8 p + i];
      r ^= b;
      i += 1;
    }
    j += 1;
  }
  return r;
}
