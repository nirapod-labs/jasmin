/* The unsigned integer remainder rounds toward minus infinity: at t = 0,
   (t - 1) % 2 is 1, the written cell. Rounding toward zero would give -1,
   out of bounds. */
export fn mod_index_neg(reg u32 a) -> reg u32
{
  reg u32[2] m;
  reg u32 x;
  inline int t;

  m[1] = a;
  x = 0;
  for t = 0 to 1 {
    x = m[(t - 1) % 2];
  }
  return x;
}
