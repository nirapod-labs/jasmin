/* IDIV of -2^64 - 1 by 2: rounded toward zero, the quotient is -2^63, which
   fits in 64 bits. Rounded toward minus infinity it would be -2^63 - 1,
   which does not. */
export fn idiv_bound() -> reg u64
{
  reg u64 hi lo d q;

  hi = -2;
  lo = -1;
  d = 2;
  ?{ RAX = q } = #IDIV(hi, lo, d);
  return q;
}
