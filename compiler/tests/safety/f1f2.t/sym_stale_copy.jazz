/* F2 through a whole-array copy: the cell b reads is overwritten by
   t = w, not by an element write. */
export fn sym_stale_copy() -> reg u64
{
  stack u64[1] t w;
  stack u64[2] u;
  reg u64 i r;
  reg bool b;
  t[0] = 0;
  w[0] = 1;
  u[0] = 0;
  u[1] = 0;
  b = t[0] == 0;
  t = w;
  r = 0;
  if (b) { i = 5; r = u[i]; }
  return r;
}
