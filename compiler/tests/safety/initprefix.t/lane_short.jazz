/* The lane shape with a fill that writes only 32 of the 64 bytes: the
   read of byte 32 of lane 0 is a read of a byte never written. */
fn fill_half(reg mut ptr u8[64] a, reg u64 v) -> reg ptr u8[64]
{
  reg u64 i;

  i = 0;
  while (i < 32) { a[i] = (8u)v; i += 1; }
  return a;
}

export fn lane_short(reg u64 v) -> reg u64
{
  stack u8[128] buf;
  reg u64 r;
  inline int k;

  for k = 0 to 2 { buf[64 * k : 64] = fill_half(buf[64 * k : 64], v); }
  r = (64u)buf[32];
  return r;
}
