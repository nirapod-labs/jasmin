/* t is written in descending order: every byte has its boolean, and a
   prefix of 8 bytes only. The second visit of leafsum at the same call
   site reuses the summary of the first. */
fn leafsum(reg ptr u64[2] p) -> reg u64
{
  reg u64 r;
  r = p[0];
  r += p[1];
  return r;
}

export fn calltop_reuse(reg u64 v) -> reg u64
{
  stack u64[2] t;
  reg u64 i r s;

  t[1] = v;
  t[0] = v;
  r = 0;
  i = 0;
  while (i < 4) { s = leafsum(t); r += s; i += 1; }
  return r;
}
