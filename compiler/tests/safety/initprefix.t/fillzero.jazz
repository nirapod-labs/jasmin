/* The fill shape of the one-shot exports: n bytes at in into buf from 0,
   a word at a time then bytes, then zeros up to 64, then word reads of the
   whole block. Every read is of a written byte. */
export fn fillzero(reg u64 in n) -> reg u64
{
  stack u8[64] buf;
  reg u64 dst t r;

  n &= 63;
  dst = 0;
  while (n >= 8) { t = [:u64 in + dst]; buf.[:u64 dst] = t; dst += 8; n -= 8; }
  while (n > 0) { t = (64u)[:u8 in + dst]; buf[dst] = (8u)t; dst += 1; n -= 1; }
  t = 0;
  while (dst < 64) { buf[dst] = (8u)t; dst += 1; }
  r = 0;
  t = buf[:u64 0];
  r ^= t;
  return r;
}
