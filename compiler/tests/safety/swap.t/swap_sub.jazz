/* A sub-array result of #swap that reads no earlier lvalue keeps its
   contents: #swap(b, t[1 : 1]) returns (t[1 : 1], b), so t[0 : 1] receives
   b and a the old t[1 : 1], all written. */
export fn swap_sub(reg u64 v) -> reg u64
{
  stack u64[1] a b;
  stack u64[2] t;
  reg u64 r s;

  t[0] = v;
  t[1] = v;
  b[0] = v;
  a, t[0 : 1] = #swap(b, t[1 : 1]);
  r = t[0];
  s = a[0];
  r += s;
  s = t[1];
  r += s;
  return r;
}
